<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Theme.ProsafetyApps" parent="Theme.MaterialComponents.Light.NoActionBar">
    <item name="colorPrimary">@color/safety_teal</item>
    <item name="colorPrimaryVariant">@color/safety_navy</item>
    <item name="colorOnPrimary">@color/white</item>
    <item name="colorSecondary">@color/safety_teal</item>
    <item name="colorOnSecondary">@color/white</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:windowBackground">@color/safety_background</item>
    <item name="android:textColorPrimary">@color/safety_navy</item>
    <item name="android:textColorSecondary">@color/safety_muted</item>
    <item name="android:statusBarColor" tools:targetApi="l">@color/safety_background</item>
    <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    <item name="android:navigationBarColor" tools:targetApi="l">@color/safety_navy</item>
