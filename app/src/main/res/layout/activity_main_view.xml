        </LinearLayout>
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/safety_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdMain" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_account" />
