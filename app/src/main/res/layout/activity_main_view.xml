              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Trusted contacts" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Set up your safety circle" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/safety_emergency" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdNumber" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_phone" />
            <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Emergency call" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Open the 999 dialer" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView style="@style/Safety.Section" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Everyday tools" />
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdTrack" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_location" />
            <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Find your way" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Directions to a place or address" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdInstruct" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_info" />
            <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Safety guide" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Understand shake alerts and permissions" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdNews" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_news" />
            <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Stay informed" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Read the latest safety news" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:id="@+id/CrdProfile" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent">
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="20dp">
            <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_person" />
            <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
              <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Your account" android:textStyle="bold" />
              <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Manage your personal details" />
            </LinearLayout>
            <TextView android:importantForAccessibility="no" android:layout_height="wrap_content" android:layout_width="24dp" android:text="›" android:textColor="@color/safety_muted" android:textSize="28sp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:paddingBottom="20dp" android:text="Calling opens your phone dialer. Review the number before placing a call." />
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <FrameLayout android:background="@color/white" android:elevation="16dp" android:layout_gravity="start" android:layout_height="match_parent" android:layout_width="320dp" android:visibility="visible">
    <include layout="@layout/main_nav_drawer" />
  </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>