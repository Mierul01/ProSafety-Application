<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/safety_background" android:layout_height="match_parent" android:layout_width="match_parent">
  <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="28dp">
    <ImageView android:contentDescription="Choose a profile photo" android:id="@+id/update_imageView" android:layout_gravity="center_horizontal" android:layout_height="96dp" android:layout_width="96dp" android:src="@drawable/defavatar" />
    <TextView style="@style/Safety.Title" android:id="@+id/textViewProfile" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_width="match_parent" android:text="Make it yours." />
    <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Add your details to complete your profile." />
    <TextView style="@style/Safety.Label" android:id="@+id/TextViewName" android:labelFor="@id/EditTextName" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Full name" />
    <EditText style="@style/Safety.Input" android:hint="Enter your full name" android:id="@+id/EditTextName" android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords" android:layout_height="wrap_content" android:layout_width="match_parent" />
    <TextView style="@style/Safety.Label" android:id="@+id/TextViewSurName" android:labelFor="@id/EditTextSurname" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Username" />
    <EditText style="@style/Safety.Input" android:hint="Choose a username" android:id="@+id/EditTextSurname" android:imeOptions="actionDone" android:inputType="text" android:layout_height="wrap_content" android:layout_width="match_parent" />
    <TextView style="@style/Safety.Label" android:id="@+id/TextViewEmail" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Email address" />
    <TextView style="@style/Safety.Body" android:background="@drawable/safety_surface" android:id="@+id/textViewEmailAdress" android:layout_height="wrap_content" android:layout_width="match_parent" android:padding="16dp" android:text="Your account email" />
    <androidx.appcompat.widget.AppCompatButton style="@style/Safety.Button" android:id="@+id/btnSaveButton" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_width="match_parent" android:text="Save and continue" />
  </LinearLayout>
</ScrollView>