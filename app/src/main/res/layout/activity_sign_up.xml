<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/white" android:fillViewport="true" android:layout_height="match_parent" android:layout_width="match_parent">
  <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">
      <ImageView android:contentDescription="ProSafety FYP logo" android:layout_height="52dp" android:layout_width="52dp" android:src="@drawable/logo" android:scaleType="fitCenter" />
      <TextView android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_width="wrap_content" android:text="ProSafety" android:textColor="@color/safety_navy" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:background="@drawable/safety_soft" android:layout_height="wrap_content" android:layout_marginBottom="28dp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
      <ImageView android:importantForAccessibility="no" android:layout_height="96dp" android:layout_width="96dp" android:src="@drawable/logo" android:scaleType="fitCenter" />
      <TextView style="@style/Safety.Section" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="A little preparation. More peace of mind." />
      <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Your people. Your tools. Always within reach." />
    </LinearLayout>
    <TextView style="@style/Safety.Title" android:id="@+id/txttitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Create your account" />
    <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Take the first step towards a safer everyday." />
    <TextView style="@style/Safety.Label" android:labelFor="@id/txtSignUpEmail" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Email address" />
    <EditText style="@style/Safety.Input" android:hint="you@example.com" android:id="@+id/txtSignUpEmail" android:imeOptions="actionNext" android:inputType="textEmailAddress" android:layout_height="wrap_content" android:layout_width="match_parent" />
    <TextView style="@style/Safety.Label" android:labelFor="@id/txtSignUpPass" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Password" />
    <EditText style="@style/Safety.Input" android:hint="At least 6 characters" android:id="@+id/txtSignUpPass" android:imeOptions="actionDone" android:inputType="textPassword" android:layout_height="wrap_content" android:layout_width="match_parent" />
    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">
      <CheckBox android:id="@+id/chk1" android:layout_height="48dp" android:layout_weight="1" android:layout_width="0dp" android:text="Show password" android:textColor="@color/safety_muted" android:textSize="13sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton style="@style/Safety.Button" android:id="@+id/btnSignUp" android:layout_height="56dp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:text="Create account" />
    <TextView style="@style/Safety.Body" android:clickable="true" android:focusable="true" android:gravity="center" android:id="@+id/AlreadyMember" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="match_parent" android:minHeight="56dp" android:onClick="navigate_sign_in" android:text="Already have an account? Sign in" android:textColor="@color/safety_teal" android:textSize="14sp" />
  </LinearLayout>
</ScrollView>
