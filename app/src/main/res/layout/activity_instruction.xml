<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/safety_background" android:id="@+id/drawer_layout" android:layout_height="match_parent" android:layout_width="match_parent">
  <LinearLayout android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">
    <include layout="@layout/main_toolbar" />
    <ScrollView android:layout_height="0dp" android:layout_weight="1" android:layout_width="match_parent">
      <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Safety.Title" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Your safety guide" />
        <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="A few simple steps to get started." />
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="01" android:textColor="@color/safety_teal" />
          <TextView style="@style/Safety.CardTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Build your safety circle" />
          <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Open Trusted contacts and tap Add a trusted contact. Choose up to 5 people from your phone." />
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="02" android:textColor="@color/safety_teal" />
          <TextView style="@style/Safety.CardTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Allow the required permissions" />
          <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Contacts, SMS and location access let the app select recipients and include your location in a help message." />
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="03" android:textColor="@color/safety_teal" />
          <TextView style="@style/Safety.CardTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Keep location available" />
          <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Turn on your phone’s location so your help message can include where you are." />
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="04" android:textColor="@color/safety_teal" />
          <TextView style="@style/Safety.CardTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Shake to request help" />
          <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Shake your phone three times to request help from your saved contacts. SMS delivery depends on your phone and network." />
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="05" android:textColor="@color/safety_teal" />
          <TextView style="@style/Safety.CardTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Keep your circle up to date" />
          <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Tap the remove icon next to a saved contact to remove them. For an emergency call, open the 999 dialer from Home." />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <FrameLayout android:background="@color/white" android:elevation="16dp" android:layout_gravity="start" android:layout_height="match_parent" android:layout_width="320dp" android:visibility="visible">
    <include layout="@layout/main_nav_drawer" />
  </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>