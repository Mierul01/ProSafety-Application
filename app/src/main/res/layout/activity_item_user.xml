<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/linear" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">
  <androidx.cardview.widget.CardView app:cardCornerRadius="16dp" app:cardElevation="0dp" android:id="@+id/cardview" android:layout_height="wrap_content" android:layout_width="match_parent">
    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="16dp">
      <ImageView app:tint="@color/safety_teal" android:importantForAccessibility="no" android:layout_height="40dp" android:layout_width="40dp" android:src="@drawable/ic_person" />
      <LinearLayout android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_weight="1" android:layout_width="0dp" android:orientation="vertical">
        <TextView style="@style/Safety.Body" android:id="@+id/tvName" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Contact name" android:textStyle="bold" />
        <TextView style="@style/Safety.Caption" android:id="@+id/tvPhone" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="Phone number" />
      </LinearLayout>
      <ImageButton app:tint="@color/safety_muted" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Remove trusted contact" android:id="@+id/removeContact" android:layout_height="48dp" android:layout_width="48dp" android:src="@drawable/ic_remove_contact" />
    </LinearLayout>
  </androidx.cardview.widget.CardView>
</LinearLayout>