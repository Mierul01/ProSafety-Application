<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/safety_background" android:id="@+id/drawer_layout" android:layout_height="match_parent" android:layout_width="match_parent">
  <LinearLayout android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">
    <include layout="@layout/main_toolbar" />
    <ScrollView android:layout_height="0dp" android:layout_weight="1" android:layout_width="match_parent">
      <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Safety.Title" android:id="@+id/txtAbout" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="We’re here to help." />
        <TextView style="@style/Safety.Body" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Have feedback or a question about ProSafety? We would love to hear from you." />
        <TextView style="@style/Safety.Section" android:id="@+id/txtEmail" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Get in touch" />
        <TextView style="@style/Safety.Body" android:autoLink="email" android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_width="match_parent" android:padding="20dp" android:text="ProsafetyApp@gmail.com" android:textColorLink="@color/safety_teal" />
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <FrameLayout android:background="@color/white" android:elevation="16dp" android:layout_gravity="start" android:layout_height="match_parent" android:layout_width="320dp" android:visibility="visible">
    <include layout="@layout/main_nav_drawer" />
  </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>