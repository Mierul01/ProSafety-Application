<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/safety_background" android:id="@+id/drawer_layout" android:layout_height="match_parent" android:layout_width="match_parent">
  <LinearLayout android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical">
    <include layout="@layout/main_toolbar" />
    <ScrollView android:fillViewport="true" android:layout_height="0dp" android:layout_weight="1" android:layout_width="match_parent">
      <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:background="@drawable/safety_hero" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">
          <ImageView android:contentDescription="Profile photo" android:id="@+id/profilePicImageView" android:layout_gravity="center_horizontal" android:layout_height="72dp" android:layout_width="72dp" android:src="@drawable/defavatar" />
          <TextView style="@style/Safety.Title" android:gravity="center" android:id="@+id/textViewProfile" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:text="Your profile" android:textColor="@color/white" />
        </LinearLayout>
        <TextView style="@style/Safety.Section" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Personal details" />
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="18dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Name" />
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">
            <TextView style="@style/Safety.Body" android:id="@+id/profile_name_textView" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:paddingBottom="12dp" android:paddingTop="12dp" android:text="Name" />
            <Button style="?attr/borderlessButtonStyle" android:id="@+id/buttonEditName" android:layout_height="48dp" android:layout_width="64dp" android:onClick="buttonClickedEditName" android:text="Edit" android:textAllCaps="false" android:textColor="@color/safety_teal" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="18dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Username" />
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">
            <TextView style="@style/Safety.Body" android:id="@+id/profile_surname_textView" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:paddingBottom="12dp" android:paddingTop="12dp" android:text="Username" />
            <Button style="?attr/borderlessButtonStyle" android:id="@+id/buttonEditSurname" android:layout_height="48dp" android:layout_width="64dp" android:onClick="buttonClickedEditSurname" android:text="Edit" android:textAllCaps="false" android:textColor="@color/safety_teal" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:background="@drawable/safety_surface" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="18dp">
          <TextView style="@style/Safety.Caption" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Email address" />
          <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">
            <TextView style="@style/Safety.Body" android:id="@+id/textViewEmailAdress" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:paddingBottom="12dp" android:paddingTop="12dp" android:text="Email address" />
          </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Safety.Body" android:background="@drawable/safety_surface" android:clickable="true" android:focusable="true" android:layout_height="56dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:onClick="ClickAboutUs" android:padding="16dp" android:text="About and support" android:textColor="@color/safety_teal" />
        <TextView style="@style/Safety.Body" android:background="@drawable/safety_surface" android:clickable="true" android:focusable="true" android:layout_height="56dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:onClick="ClickShare" android:padding="16dp" android:text="Share ProSafety" android:textColor="@color/safety_teal" />
        <androidx.appcompat.widget.AppCompatButton style="@style/Safety.Button" android:id="@+id/btn_log_out" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:onClick="navigateLogOut" android:text="Log out" />
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <FrameLayout android:background="@color/white" android:elevation="16dp" android:layout_gravity="start" android:layout_height="match_parent" android:layout_width="320dp" android:visibility="visible">
    <include layout="@layout/main_nav_drawer" />
  </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>