      <WebView app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:id="@+id/myWebView" android:layout_height="match_parent" android:layout_width="match_parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
  </LinearLayout>
